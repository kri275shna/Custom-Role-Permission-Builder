  "item": [
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Get Permission Matrix",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/permissions",
              "host": ["{{base_url}}"],
              "path": ["permissions"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/roles",
              "host": ["{{base_url}}"],
              "path": ["roles"]
            }
          },
          "response": []
        },
        {
          "name": "Get Role By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/roles/role-admin",
              "host": ["{{base_url}}"],
              "path": ["roles", "role-admin"]
            }
          },
          "response": []
        },
        {
          "name": "Create Custom Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Support Agent\",\n  \"description\": \"Handles customer issues and views settings.\",\n  \"permissions\": [\n    \"projects:view\",\n    \"tasks:view\",\n    \"settings:view\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/roles",
              "host": ["{{base_url}}"],
              "path": ["roles"]
            }
          },
          "response": []
        },
        {
          "name": "Update Custom Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description for support agents.\",\n  \"permissions\": [\n    \"projects:view\",\n    \"tasks:view\",\n    \"tasks:edit\",\n    \"settings:view\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/roles/{{custom_role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{custom_role_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Custom Role",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/roles/{{custom_role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{custom_role_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
